{
  "name": "betfront-svelte",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5175 --strictPort",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:unit": "node --test --experimental-strip-types tests/unit/**/*.test.ts",
    "test:e2e": "npx playwright test --project=chromium-hybrid",
    "test:e2e:cross-browser": "npx playwright test --project=firefox-hybrid-smoke --project=webkit-hybrid-smoke",
    "test:e2e:live": "E2E_MODE=live npx playwright test --project=chromium-live",
    "test:e2e:pwa": "npx playwright test --config=playwright.pwa.config.ts",
    "check:e2e": "tsc --noEmit --pretty false --moduleResolution bundler --module ESNext --target ESNext --strict --esModuleInterop --allowImportingTsExtensions --resolveJsonModule --skipLibCheck --lib ESNext,DOM --types node,@playwright/test ./tests/e2e/helpers/*.ts ./tests/e2e/hybrid/*.ts ./tests/e2e/live/*.ts ./tests/e2e/pwa/*.ts"
  },
  "dependencies": {
    "bits-ui": "^2.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "layerchart": "^1.0.13",
    "lucide-svelte": "^0.500.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@sveltejs/adapter-node": "^5.5.7",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^25.9.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.23",
    "svelte": "^5.56.7",
    "svelte-check": "^4.0.0",
    "svelte-meta-tags": "5.0.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.1.5"
  }
}
