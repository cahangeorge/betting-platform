# PostgreSQL
POSTGRES_PASSWORD=change_me_prod

# Redis
REDIS_URL=redis://redis:6379/0

# Database URL (rendered from template - do not change)
DATABASE_URL=postgresql+asyncpg://betuser:${POSTGRES_PASSWORD}@postgres:5432/betting_platform

# Authentication
JWT_SECRET=generate-a-strong-random-secret

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENVIRONMENT=development

# Backend-owned Taskiq lane topology. `bet`/`bet-workers` remain the durable
# control backlog for compatibility; provider lanes are selected only by the
# backend worker-lane contract, never by an upstream provider.
BET_TASKIQ_QUEUE_NAME=bet
BET_TASKIQ_CONSUMER_GROUP=bet-workers
BET_TASKIQ_ENABLED_LANES=control,provider-http,provider-browser,model-cpu
# New work admission may be narrower than enabled consumers during a drain.
BET_TASKIQ_ADMITTED_LANES=control,provider-http,provider-browser,model-cpu
BET_TASKIQ_PROVIDER_HTTP_QUEUE_NAME=bet-provider-http
BET_TASKIQ_PROVIDER_HTTP_CONSUMER_GROUP=bet-provider-http-workers
BET_TASKIQ_PROVIDER_BROWSER_QUEUE_NAME=bet-provider-browser
BET_TASKIQ_PROVIDER_BROWSER_CONSUMER_GROUP=bet-provider-browser-workers
BET_TASKIQ_MODEL_CPU_QUEUE_NAME=bet-model-cpu
BET_TASKIQ_MODEL_CPU_CONSUMER_GROUP=bet-model-cpu-workers
# Opaque model artifacts are backend-generated and must be retained outside /tmp.
# Compose mounts this as /model-artifacts; local bare-metal may use an absolute path.
BET_MODEL_ARTIFACT_ROOT=/model-artifacts
# Compose fixes each pool's process/async/prefetch caps at control 1/2/2,
# HTTP 1/4/4, browser 1/1/1 and model 1/1/1.
BET_TASKIQ_CONTROL_WORKER_PROCESSES=1
BET_TASKIQ_CONTROL_MAX_ASYNC_TASKS=2
BET_TASKIQ_CONTROL_PREFETCH=2
BET_TASKIQ_PROVIDER_HTTP_WORKER_PROCESSES=1
BET_TASKIQ_PROVIDER_HTTP_MAX_ASYNC_TASKS=4
BET_TASKIQ_PROVIDER_HTTP_PREFETCH=4
BET_TASKIQ_PROVIDER_BROWSER_WORKER_PROCESSES=1
BET_TASKIQ_PROVIDER_BROWSER_MAX_ASYNC_TASKS=1
BET_TASKIQ_PROVIDER_BROWSER_PREFETCH=1
BET_TASKIQ_MODEL_CPU_WORKER_PROCESSES=1
BET_TASKIQ_MODEL_CPU_MAX_ASYNC_TASKS=1
BET_TASKIQ_MODEL_CPU_PREFETCH=1

# Hybrid scraper v2 is canary-only until the rollout gates in
# docs/adr/2026-07-30-hybrid-scraping-pipeline-v2.md pass. Values are 0..100
# and selection is deterministic by scrape job ID.
BET_SCRAPE_PIPELINE_V2_PERCENT=0

# Frontend
PUBLIC_API_URL=http://localhost:5173
ORIGIN=http://localhost:5173
