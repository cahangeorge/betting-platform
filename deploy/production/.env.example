# Copy outside Git and replace through a secret manager. Never put real values here.
POSTGRES_IMAGE=registry.example/bet/postgres@sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
REDIS_IMAGE=registry.example/bet/redis@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
BET_API_IMAGE=registry.example/bet/api@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
BET_FRONTEND_IMAGE=registry.example/bet/frontend@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
NGINX_IMAGE=registry.example/bet/nginx@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
BET_PUBLIC_HOST=bet.example.com
BET_HTTP_PORT=80
BET_HTTPS_PORT=443
TLS_CERT_PATH=/run/secrets/bet/tls.crt
TLS_KEY_PATH=/run/secrets/bet/tls.key
POSTGRES_USER=__SECRET_FROM_MANAGER__
POSTGRES_PASSWORD=__SECRET_FROM_MANAGER__
POSTGRES_DB=__SECRET_FROM_MANAGER__
BET_DATABASE_URL=__SECRET_FROM_MANAGER__
REDIS_PASSWORD=__SECRET_FROM_MANAGER__
BET_REDIS_URL=__SECRET_FROM_MANAGER__
BET_TASKIQ_RESULT_BACKEND_URL=__SECRET_FROM_MANAGER__
BET_JWT_SECRET=__SECRET_FROM_MANAGER__

# Single-host resource and local-log ceilings. Tune from measured staging
# usage; do not remove ceilings to hide capacity or leak-disk problems.
BET_CONTAINER_MEMORY_LIMIT=2g
BET_CONTAINER_CPU_LIMIT=2.0
BET_CONTAINER_PIDS_LIMIT=512
BET_CONTAINER_LOG_MAX_SIZE=10m
BET_CONTAINER_LOG_MAX_FILES=5

# Per-process safety bounds. Keep authentication throttling enabled. A
# multi-replica deployment also requires shared edge/proxy rate limiting and
# shared WebSocket admission/pub-sub before increasing these defaults.
BET_AUTH_RATE_LIMIT_ENABLED=true
BET_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
BET_AUTH_LOGIN_MAX_ATTEMPTS=10
BET_AUTH_SIGNUP_MAX_ATTEMPTS=5
BET_AUTH_SOURCE_MAX_ATTEMPTS=1000
BET_AUTH_RATE_LIMIT_MAX_SOURCES=10000
BET_AUTH_RATE_LIMIT_MAX_IDENTITIES=100000
BET_WEBSOCKET_MAX_CONNECTIONS=100
BET_WEBSOCKET_MAX_CONNECTIONS_PER_USER=3
BET_WEBSOCKET_RECEIVE_TIMEOUT_SECONDS=300
BET_WEBSOCKET_SEND_TIMEOUT_SECONDS=5
BET_WEBSOCKET_MAX_MESSAGE_BYTES=8192
