FROM python:3.12-slim@sha256:57cd7c3a7a273101a6485ba99423ee568157882804b1124b4dd04266317710de

WORKDIR /app

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    git \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/ ./backend/
COPY OddsHarvester/ ./OddsHarvester/
COPY penaltyblog/ ./penaltyblog/
COPY soccerdata/ ./soccerdata/

RUN pip install --no-cache-dir uv==0.11.25 \
    && uv pip install --system --strict --no-cache \
    --requirement backend/requirements-production.lock \
    && python -m playwright install --with-deps chromium \
    && python -m pip uninstall --yes uv \
    && apt-get autoremove --purge -y \
    gcc \
    g++ \
    git \
    libpq-dev \
    xvfb \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/backend

ENV HOME=/home/appuser

RUN addgroup --system --gid 1001 appuser \
    && adduser --system --uid 1001 --gid 1001 --home "$HOME" appuser \
    && mkdir -p "$HOME" \
    && chown -R appuser:appuser /app "$PLAYWRIGHT_BROWSERS_PATH" "$HOME"

USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
