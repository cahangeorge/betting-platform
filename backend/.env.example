# Betting Platform — Environment Template
# Copy to .env and fill in your credentials

# App
DEBUG=true
APP_NAME=betting-platform

# Database (SQLite for dev, Postgres for prod)
# DATABASE_URL=sqlite+aiosqlite:///./betting.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/betting

# JWT
JWT_SECRET=your-production-secret-at-least-32-chars
JWT_EXPIRE_MINUTES=60

# ── Betfair Exchange API ────────────────────────────
# Free delayed app key: https://developer.betfair.com/
#   - Delayed: 60s delay, no cost, no activation fee
#   - Live:    £499 one-time, real-time, can place real orders
# Requires a Betfair account + KYC verification
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_SESSION_TOKEN=

# ── Matchbook Exchange API ──────────────────────────
# Free tier: up to 1M GET requests/month
# Commission: 2% on net profit per market only (no commission on losses)
# Docs: https://developers.matchbook.com/
MATCHBOOK_USERNAME=
MATCHBOOK_PASSWORD=

# ── Football-Data.org (live stats) ──────────────────
# Free tier: 10 req/min, current season data
# Get key at: https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=