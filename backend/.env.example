BET_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/bet
# Valid values: development, test, staging, production. Staging/production fail closed
# unless the JWT secret is non-placeholder, at least 32 characters, and cookies are secure.
# Production additionally requires BET_DEBUG=false, BET_TASK_QUEUE_BACKEND=taskiq,
# explicit CORS origins, and all trading flags disabled.
BET_ENVIRONMENT=development
BET_JWT_SECRET=replace-with-a-random-32-plus-character-secret-before-staging-or-production
BET_COOKIE_SECURE=false
# Explicit credentialed origins only. Add a tunnel or deployment origin here when needed.
BET_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://localhost:3000,http://localhost:3002,http://localhost:8080

# Authentication abuse protection is per API process. Keep it enabled in every
# environment; multi-replica deployments also need a shared edge/proxy limiter.
BET_AUTH_RATE_LIMIT_ENABLED=true
BET_AUTH_RATE_LIMIT_WINDOW_SECONDS=300
BET_AUTH_LOGIN_MAX_ATTEMPTS=10
BET_AUTH_SIGNUP_MAX_ATTEMPTS=5
BET_AUTH_SOURCE_MAX_ATTEMPTS=1000
BET_AUTH_RATE_LIMIT_MAX_SOURCES=10000
BET_AUTH_RATE_LIMIT_MAX_IDENTITIES=100000

# WebSocket admission and backpressure limits are per API process. Horizontal
# production scaling additionally needs shared pub/sub and admission control.
BET_WEBSOCKET_MAX_CONNECTIONS=100
BET_WEBSOCKET_MAX_CONNECTIONS_PER_USER=3
BET_WEBSOCKET_RECEIVE_TIMEOUT_SECONDS=300
BET_WEBSOCKET_SEND_TIMEOUT_SECONDS=5
BET_WEBSOCKET_MAX_MESSAGE_BYTES=8192

# Python bridge/runtime paths. If unset, the backend will try repo-local defaults
# and warn at startup when they do not exist.
# For soccerdata, run `cd soccerdata && uv sync`, verify `.venv/bin/python`
# exists, then point BET_SOCCERDATA_PYTHON at that interpreter.
BET_PENALTYBLOG_PYTHON=/absolute/path/to/bet/penaltyblog/.venv/bin/python
BET_PENALTYBLOG_BRIDGE=/absolute/path/to/bet/backend/app/bridges/penaltyblog_bridge.py
BET_PENALTYBLOG_ROOT=/absolute/path/to/bet/penaltyblog
# Backend-owned opaque artifact directory. The model-cpu worker writes it; API
# processes only verify/read it. It must be shared and durable in Compose.
BET_MODEL_ARTIFACT_ROOT=/absolute/path/to/bet/.model-artifacts
BET_SOCCERDATA_PYTHON=/absolute/path/to/bet/soccerdata/.venv/bin/python
BET_SOCCERDATA_BRIDGE=/absolute/path/to/bet/backend/app/bridges/soccerdata_bridge.py
BET_SOCCERDATA_ROOT=/absolute/path/to/bet/soccerdata
BET_ODDSHARVESTER_PYTHON=/absolute/path/to/bet/OddsHarvester/.venv/bin/python
BET_ODDSHARVESTER_TIMEOUT_SECONDS=600
# Licensed odds sources remain disabled until an explicit registry approval is
# introduced. Do not put this value in logs, URLs, fixtures, or Git.
BET_SPORTMONKS_API_TOKEN=
BET_SPORTMONKS_TIMEOUT_SECONDS=20

# Use "taskiq" with Redis workers for long-running jobs; keep "inline" only for tests
# or local development without a worker process. Production rejects inprocess/inline.
BET_TASK_QUEUE_BACKEND=inline
BET_REDIS_URL=redis://localhost:6379/0
BET_TASKIQ_QUEUE_NAME=bet
BET_TASKIQ_CONSUMER_GROUP=bet-workers
# The control queue above is backward-compatible. These dedicated values are
# selected by BET_TASKIQ_WORKER_LANE in the worker process, not by callers.
BET_TASKIQ_WORKER_LANE=control
BET_TASKIQ_ENABLED_LANES=control,provider-http,provider-browser,model-cpu
# Keep provider consumers enabled but close admission to drain their backlog.
BET_TASKIQ_ADMITTED_LANES=control,provider-http,provider-browser,model-cpu
BET_TASKIQ_PROVIDER_HTTP_QUEUE_NAME=bet-provider-http
BET_TASKIQ_PROVIDER_HTTP_CONSUMER_GROUP=bet-provider-http-workers
BET_TASKIQ_PROVIDER_BROWSER_QUEUE_NAME=bet-provider-browser
BET_TASKIQ_PROVIDER_BROWSER_CONSUMER_GROUP=bet-provider-browser-workers
BET_TASKIQ_MODEL_CPU_QUEUE_NAME=bet-model-cpu
BET_TASKIQ_MODEL_CPU_CONSUMER_GROUP=bet-model-cpu-workers
BET_TASKIQ_CONTROL_WORKER_PROCESSES=1
BET_TASKIQ_CONTROL_MAX_ASYNC_TASKS=2
BET_TASKIQ_CONTROL_PREFETCH=2
BET_TASKIQ_PROVIDER_HTTP_WORKER_PROCESSES=1
BET_TASKIQ_PROVIDER_HTTP_MAX_ASYNC_TASKS=4
BET_TASKIQ_PROVIDER_HTTP_PREFETCH=4
BET_TASKIQ_PROVIDER_BROWSER_WORKER_PROCESSES=1
BET_TASKIQ_PROVIDER_BROWSER_MAX_ASYNC_TASKS=1
BET_TASKIQ_PROVIDER_BROWSER_PREFETCH=1
BET_TASKIQ_MODEL_CPU_WORKER_PROCESSES=1
BET_TASKIQ_MODEL_CPU_MAX_ASYNC_TASKS=1
BET_TASKIQ_MODEL_CPU_PREFETCH=1
BET_TASKIQ_POLL_INTERVAL_SECONDS=60
BET_TASKIQ_RESULT_TTL_SECONDS=86400
BET_TASKIQ_RUNTIME_HEARTBEAT_SECONDS=10
BET_TASKIQ_RUNTIME_STALE_SECONDS=30
BET_TASK_PUBLISH_REPLAY_GRACE_SECONDS=900

# Paper-local trading only. Live order placement has no implementation and
# remains false; production rejects all trading flags, while staging may opt in
# to paper-local testing explicitly.
BET_TRADING_ENABLED=true
BET_TRADING_PAPER_ENABLED=true
BET_TRADING_LIVE_ENABLED=false
BET_TRADING_BETFAIR_READ_ONLY_ENABLED=false
BET_TRADING_TASKIQ_QUEUE_NAME=bet-trading
BET_SCHEDULED_JOBS_ENABLED=false
